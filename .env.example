# homepage · environment template
# copy to .env and fill in as providers come online (Phase 1+).
# .env is gitignored — never commit real credentials.

# ── runtime ──
PORT=3000
TZ=Europe/Madrid

# ── minecraft (Phase 1.1) ──
MC_HOST=minecraft-main
MC_PORT=25565

# ── news rss (Phase 1.2) ──
# comma-separated feed urls, optional overrides
NEWS_TECH_FEEDS=
NEWS_GAMES_FEEDS=

# ── docker (Phase 1.3) ──
DOCKER_SOCKET=/var/run/docker.sock

# ── github (Phase 1.4) ──
GITHUB_TOKEN=
GITHUB_USER=Fi3w0

# ── steam (Phase 1.5) ──
STEAM_API_KEY=
STEAM_ID=

# ── twitch (Phase 1.6) ──
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_USER_ID=

# ── spotify (Phase 1.7) ──
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# ── discord (Phase 1.8) ──
# we reuse the existing discord-bot container by adding a /presence/:user_id
# HTTP route on it. set the URL the homepage server will hit.
DISCORD_PRESENCE_URL=http://discord-bot:3001/presence
DISCORD_USER_ID=
